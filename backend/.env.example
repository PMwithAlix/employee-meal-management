NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://khaan:khaan@localhost:5432/khaan?schema=public
# Public UI origin. Same-host reverse proxy is also accepted.
FRONTEND_ORIGIN=http://localhost:5173

POSTGRES_USER=khaan
POSTGRES_PASSWORD=khaan
POSTGRES_DB=khaan
POSTGRES_PORT=5432

SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=khaan.sid
SESSION_COOKIE_PATH=/
SESSION_SAMESITE=lax
SESSION_SECURE=false
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=khaan.admin
BOOTSTRAP_ADMIN_PASSWORD=Nakhoda-Khaan1405

# Bale Mini App / Bot — leave disabled until secrets are set on the server.
# Never commit a real BALE_BOT_TOKEN or BALE_WEBHOOK_SECRET.
# When BALE_MINI_APP_ENABLED=true, BALE_BOT_TOKEN and BALE_WEBHOOK_SECRET (min 16 chars) are required.
BALE_MINI_APP_ENABLED=false
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai/bot
BALE_MINI_APP_URL=https://food.kavosh.site/mini-app
BALE_WEBHOOK_URL=
BALE_WEBHOOK_SECRET=
BALE_INIT_DATA_TTL_SECONDS=86400
