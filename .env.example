# Copy to `.env` next to compose.yaml. Do not commit `.env`.

NODE_ENV=production
WEB_PORT=8080
# Browser Origin of the UI. Same-host nginx /api proxy is also accepted.
# For a public domain set e.g. https://khaan.example.com
FRONTEND_ORIGIN=http://localhost:8080

POSTGRES_USER=khaan
POSTGRES_PASSWORD=khaan
POSTGRES_DB=khaan
POSTGRES_PORT=5432

SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=khaan.sid
SESSION_COOKIE_PATH=/
SESSION_SAMESITE=lax
SESSION_SECURE=false

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# First ADMIN when the users table is empty. Change it from Settings after login.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=khaan.admin
BOOTSTRAP_ADMIN_PASSWORD=Nakhoda-Khaan1405

BALE_MINI_APP_ENABLED=false
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai/bot
BALE_MINI_APP_URL=https://food.kavosh.site/mini-app
BALE_WEBHOOK_URL=
BALE_WEBHOOK_SECRET=

# Leave empty so the browser talks to /api on the same origin (nginx proxy).
VITE_API_BASE_URL=

# CI/CD image names, e.g. ghcr.io/org/khaan-backend:sha
# KHAAN_BACKEND_IMAGE=
# KHAAN_WEB_IMAGE=
