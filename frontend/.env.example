# Empty uses the Vite/nginx same-origin proxy to /api (recommended).
# Direct backend, e.g. http://localhost:3000, requires CORS FRONTEND_ORIGIN to match this app.
VITE_API_BASE_URL=
# Production images stay off unless this is "true" at build time.
# `npm run dev` enables /mini-app unless this is set to false.
VITE_BALE_MINI_APP_ENABLED=
